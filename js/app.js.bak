// Rendering helpers
// -----------------------
// Clean description: remove hashtags and trailing tag-lists
function sanitizeDescription(s){
  if (!s) return '';
  let out = String(s);
  out = out.replace(/#\S+/g, '');
  // remove common bundle/discount promotional lines like "GET 15% OFF" or "BUNDLE DISCOUNT"
  out = out.replace(/(?:bundle discount|get\s*\d+%?\s*off|\d+%?\s*off)/gi, '');
  out = out.replace(/(?:,\s*[^,]{1,40}){2,}\s*$/,'');
  out = out.replace(/\s+/g,' ').trim();
  out = out.replace(/^[,;:\-\s]+|[,;:\-\s]+$/g,'').trim();
  return out;
}

// Build a responsive srcset for eBay CDN image URLs when possible
function makeSrcset(url){
  if(!url || typeof url !== 'string') return '';
  try{
    if(!/s-l\d+/i.test(url)) return '';
    const small = url.replace(/s-l\d+/i, 's-l140');
    const med = url.replace(/s-l\d+/i, 's-l500');
    const med2 = url.replace(/s-l\d+/i, 's-l960');
    const large = url.replace(/s-l\d+/i, 's-l1600');
    return `${small} 140w, ${med} 500w, ${med2} 960w, ${large} 1600w`;
  }catch(e){ return ''; }
}
window.makeSrcset = makeSrcset;

// Clean existing product descriptions (import-time should handle this, but sanitize any legacy entries)
products.forEach(p => { if (p && p.description) p.description = sanitizeDescription(p.description); });

function formatPrice(p){ return `$${p}`; }

function createProductCard(prod){
  // Create DOM elements for a product card. We keep structure simple.
  const article = document.createElement('article');
  // Add 'sold' class to the article when item is sold so CSS can dim it
  article.className = prod.status==='sold' ? 'product sold' : 'product';

  // Make the whole card keyboard-focusable and clickable — navigates to detail page
  article.tabIndex = 0;
  const detailHref = `product.html?id=${encodeURIComponent(prod.id)}`;
  article.addEventListener('click', (e) => {
    // if click originates from a link like Buy, let it proceed
    const tag = e.target && e.target.tagName && e.target.tagName.toLowerCase();
    if (tag === 'a' || tag === 'button') return;
    window.location.href = detailHref;
  });
  article.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      window.location.href = detailHref;
    }
  });

  // Clean display name (strip trailing "| eBay")
  const displayName = (prod.name || '').replace(/\s*\|\s*eBay$/i, '');
  // Image area: if an image URL is provided, render a real <img>. Otherwise show simple placeholder text "Photo".
  let imgSection = '';
  const thumb = (prod.images && prod.images.length) ? prod.images[0] : (prod.image || '');
  if (thumb) {
    const thumbSrc = (/s-l\d+/i.test(thumb)) ? thumb.replace(/s-l\d+/i,'s-l500') : thumb;
    const srcset = makeSrcset(thumb);
    const sizes = '120px';
    imgSection = `<div class="img-placeholder" role="img" aria-label="${displayName} image"><img src="${thumbSrc}" ${srcset?`srcset="${srcset}" sizes="${sizes}"`:''} loading="lazy" decoding="async" alt="${displayName}"></div>`;
  } else {
    imgSection = `<div class="img-placeholder" role="img" aria-label="${displayName} placeholder">Photo</div>`;
  }

  article.innerHTML = `
    ${imgSection}
    <div class="details">
      <div class="name">${displayName}</div>
      <div class="price">${formatPrice(prod.price)}</div>
      <div class="meta">${prod.size}</div>
    </div>
    <div style="display:flex;flex-direction:column;gap:8px;align-items:flex-end">
      ${prod.status==='sold'?'<div class="badge sold">Sold</div>':''}
      <a class="buy" ${prod.status==='sold'?'aria-disabled="true" tabindex="-1" data-disabled="true"':''} href="${prod.status==='sold'? '#': prod.stripeLink}" target="_blank" rel="noopener">Buy Now</a>
      <div class="buy-note">You’ll be asked to specify the item at checkout.</div>
    </div>
  `;

  // Prevent the Buy link from triggering the card click navigation
  const buy = article.querySelector('.buy');
  if (buy) buy.addEventListener('click', (ev) => ev.stopPropagation());

  return article;
}

function renderProducts(){
  const container = document.querySelector('.products');
  if(!container) return;
  container.innerHTML = ''; // clear existing
  const filter = window.__productFilter || '';
  const q = filter.trim().toLowerCase();
  const filtered = products.filter(p => {
    if (!q) return true;
    const hay = [].join(' ').toLowerCase();
    return hay.indexOf(q) !== -1;
  });
  filtered.forEach(p => container.appendChild(createProductCard(p)));
}

// Render after DOM ready
document.addEventListener('DOMContentLoaded', ()=>{
  renderProducts();
  setupSearch && setupSearch();
});

// Expose products for debugging/editing in console
window._products = products;
window._stripe = typeof JACKETS_STRIPE_LINK !== 'undefined' ? JACKETS_STRIPE_LINK : '';

// Helper: find product by id (used by product.html)
function getProductById(id){
  return products.find(p => p.id === id);
}
window.getProductById = getProductById;

// Search UI setup: toggles the search input and wires live filtering
function setupSearch(){
  const toggle = document.getElementById('search-toggle');
  const wrap = document.querySelector('.search-wrap');
  const input = document.getElementById('site-search');
  if (!toggle || !wrap || !input) return;
  toggle.addEventListener('click', ()=>{
    const open = wrap.style.display !== 'none';
    if (open) {
      wrap.style.display = 'none';
      toggle.setAttribute('aria-expanded','false');
      input.value = '';
      window.__productFilter = '';
      renderProducts();
    } else {
      wrap.style.display = 'block';
      toggle.setAttribute('aria-expanded','true');
      input.focus();
    }
  });
  let last = '';
  input.addEventListener('input', (e)=>{
    const v = e.target.value || '';
    if (v === last) return;
    last = v;
    window.__productFilter = v;
    renderProducts();
  });
}
window.setupSearch = setupSearch;
